# Copy to backend/.env and adjust as needed. Defaults match docker-compose.yml.
# For Wave 2 use the dedicated DB name `constructo_wave2`.
DATABASE_URL=postgresql+asyncpg://constructo:constructo@localhost:5433/constructo_wave2
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-secret-change-me-to-a-real-32byte-key
INGEST_API_KEY=dev-ingest-key

# ---- Extraction queue ------------------------------------------------------
# When true, /ingest runs extraction INLINE (no Redis worker needed). Handy for
# tests and quick local loops. Leave false to use the RQ worker.
# EXTRACTION_SYNC=false
# EXTRACTION_QUEUE=extraction

# ---- Shared media folder ---------------------------------------------------
# The WhatsApp bridge writes downloaded media here and extraction (OCR/STT)
# reads it back. The bridge and backend must agree on this path. Prefer an
# absolute path that both processes can see.
# MEDIA_DIR=/absolute/path/to/constructo/media

# ---- Nightly brief scheduler (in-process APScheduler) ----------------------
# Off by default. Set true on the long-running API process to schedule the
# nightly brief at BRIEF_HOUR (local to BRIEF_TIMEZONE).
# ENABLE_SCHEDULER=false
# BRIEF_HOUR=7
# BRIEF_TIMEZONE=Asia/Kolkata
#
# When ENABLE_SCHEDULER=true the same process also runs two extra jobs:
#  - SLA escalation sweep (app.approvals.sla.run_sla_sweep) every SLA_SWEEP_MINUTES
#    so overdue homeowner questions escalate promptly.
#  - Permit alert sweep (app.permits.alerts.run_permit_sweep) once daily at
#    PERMIT_SWEEP_HOUR (local to BRIEF_TIMEZONE) for expiry/renewal/staleness.
# Manual triggers (owner-only) live at POST /api/v1/admin/run-sla-sweep,
# /run-permit-sweep, /run-nightly, /reindex.
# SLA_SWEEP_MINUTES=20
# PERMIT_SWEEP_HOUR=6

# ---- Search embeddings (semantic search index) -----------------------------
# New site events are embedded and indexed inline after extraction so search
# works. Provider selected by EMBEDDINGS_PROVIDER (falls back to LLM_PROVIDER,
# default openai); when creds are absent a deterministic FakeEmbeddings is used,
# so indexing/search degrade gracefully offline and tests never hit the network.
# Backfill existing rows: `python -m app.search.index` or POST /api/v1/admin/reindex.
# EMBEDDINGS_PROVIDER=openai          # openai (default) | azure
# EMBEDDINGS_MODEL=text-embedding-3-small   # openai path only
# OPENAI_API_KEY=sk-...               # openai path
# Azure path reuses AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_API_KEY / AZURE_OPENAI_API_VERSION
# plus a dedicated embeddings deployment:
# AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# ---- LLM / OCR / STT (optional; falls back to deterministic Fakes) ---------
# Each provider selects its client by a *_PROVIDER env var. When the matching
# credentials are absent, the pipeline falls back to a deterministic Fake, so
# tests and offline dev never hit the network.
#
# OpenAI path:
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# STT_MODEL=whisper-1
# OCR_MODEL=gpt-4o-mini
#
# Azure OpenAI path (shared endpoint/key; set the provider you want to "azure"):
# LLM_PROVIDER=azure          # openai (default) | azure
# STT_PROVIDER=azure          # openai (default) | azure  (Azure Whisper)
# OCR_PROVIDER=azure          # openai (default) | azure  (gpt-4o-mini vision)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini      # used by LLM + OCR (vision)
# AZURE_WHISPER_DEPLOYMENT=whisper         # separate Whisper deployment for STT
# NOTE: Azure Whisper needs a Whisper deployment in a supported region. If
# unavailable, swap STT to Sarvam (Saaras) later — same STTClient interface.

# ---- WhatsApp send ---------------------------------------------------------
# Mode: dry_run (default) | url | cloud_api
# WHATSAPP_SEND_MODE=dry_run
#
# url mode: POST {to_phone, text} to your own relay/webhook
# WHATSAPP_SEND_URL=http://localhost:9000/send
#
# cloud_api mode: WhatsApp Cloud API (graph.facebook.com).
#   IMPORTANT: free-form text only delivers inside the 24h customer-service
#   window (the owner/test number must have messaged you within 24h); otherwise
#   Meta requires a pre-approved template. The Meta test token also expires every
#   24h -> use a permanent System User token for a real pilot.
# WHATSAPP_TOKEN=EAAG...                       # Bearer token
# WHATSAPP_PHONE_NUMBER_ID=1094260843779305    # pilot phone_number_id
