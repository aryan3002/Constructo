{
  "expo": {
    "name": "Neev",
    "slug": "constructo",
    "scheme": "neev",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "build.neev.app",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Neev saves your site photos here.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "build.neev.app",
      "adaptiveIcon": {
        "backgroundColor": "#F3EFE6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#f2a100"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Neev uses your photos so you can share progress and flag issues."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Neev uses your camera so you can capture site photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Neev saves your site photos to your gallery.",
          "savePhotosPermission": "Neev saves your site photos to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Neev needs the microphone so you can record a voice note for your site team."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "196d5226-6441-4e5d-be71-48cd7822d994"
      }
    },
    "owner": "atripa38",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/196d5226-6441-4e5d-be71-48cd7822d994"
    }
  }
}
