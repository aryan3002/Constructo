# Base URL of the Constructo FastAPI backend the app talks to.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time.
#
#   iOS simulator           -> http://localhost:8000
#   Android emulator (AVD)  -> http://10.0.2.2:8000   (host loopback)
#   Physical device / Expo Go on Wi-Fi -> http://<your-LAN-ip>:8000
#   Deployed backend        -> https://api.yourhost.com
EXPO_PUBLIC_API_BASE=http://localhost:8000
