# Base URL of the Constructo FastAPI backend the app talks to.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time, so restart
# `expo start` after changing this. Copy this file to .env first:
#     [ -f .env ] || cp .env.example .env
#
# A phone/emulator CANNOT reach "localhost" — that's the device itself. Pick the
# option that matches where the app runs:
#
#   iOS simulator            -> http://localhost:8000
#   Android emulator (AVD)   -> http://10.0.2.2:8000        (host loopback)
#        ...or run `adb reverse tcp:8000 tcp:8000` once, then use localhost:8000
#   Physical device (Expo Go on the same Wi-Fi) -> http://<your-LAN-ip>:8000
#        find your LAN IP:  macOS: `ipconfig getifaddr en0`  (try en1 on Wi-Fi)
#                           Linux: `hostname -I`             Windows: `ipconfig`
#        e.g. EXPO_PUBLIC_API_BASE=http://192.168.1.23:8000
#   Expo tunnel (no shared LAN) -> run `npx expo start --tunnel`; the device
#        reaches your machine through the tunnel — set this to the LAN IP above
#        (or run the backend behind the tunnel) — simplest is LAN IP on Wi-Fi.
#   Deployed backend         -> https://api.yourhost.com
#
# The backend MUST bind all interfaces for a device to reach it:
#     uv run uvicorn app.main:app --host 0.0.0.0 --port 8000
EXPO_PUBLIC_API_BASE=http://10.0.2.2:8000
