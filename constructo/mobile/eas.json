{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "http://10.0.2.2:8000",
        "EXPO_PUBLIC_WEB_BASE": "https://constructo-topaz.vercel.app"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://constructo-api.wittytree-3a917044.eastus.azurecontainerapps.io",
        "EXPO_PUBLIC_WEB_BASE": "https://constructo-topaz.vercel.app"
      }
    },
    "production-apk": {
      "channel": "production",
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://constructo-api.wittytree-3a917044.eastus.azurecontainerapps.io",
        "EXPO_PUBLIC_WEB_BASE": "https://constructo-topaz.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
