# Copy to .env and fill in. The bridge reads these via dotenv at startup.

# Base URL of the Constructo backend. The bridge POSTs to ${BACKEND_URL}/api/v1/ingest.
BACKEND_URL=http://localhost:8000

# Shared secret sent as the `X-Ingest-Key` header. MUST match the backend's
# INGEST_API_KEY (see backend/.env.example -> INGEST_API_KEY=dev-ingest-key).
INGEST_API_KEY=dev-ingest-key

# Directory where downloaded media (images/voice/video/documents) are written.
# media_url in each RawMessage is the local path to the saved file (pilot only).
MEDIA_DIR=./media

# Directory where Baileys persists the multi-file auth state (device creds).
AUTH_DIR=./auth

# When true (or "1"/"yes"), the bridge LOGS each RawMessage payload instead of
# POSTing it. Also enabled via the `--dry-run` CLI flag. Use this to exercise
# the mapping + post pipeline without a running backend.
DRY_RUN=false
