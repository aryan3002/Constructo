; ============================================================================
;  whatsapp-bridge npm config — READ THIS BEFORE REGENERATING THE LOCKFILE
; ============================================================================
;  package-lock.json MUST keep the cross-platform optional-dependency nodes
;  "node_modules/@emnapi/core" and "node_modules/@emnapi/runtime" (a wasm
;  fallback pulled in transitively, via @rolldown/binding-wasm32-wasi). Those
;  nodes have no os/cpu restriction, but their parent wasm32 binding is kept for
;  ALL platforms — while npm, when run on macOS/arm64, PRUNES the @emnapi child
;  nodes out of the lockfile. That leaves a dangling reference and makes
;  `npm ci` on the Linux CI runner fail with:
;
;    npm error `npm ci` can only install packages when your package.json and
;    package-lock.json are in sync.
;    Missing: @emnapi/runtime@1.10.0 from lock file
;    Missing: @emnapi/core@1.10.0 from lock file
;
;  ==> DO NOT run a plain `npm install` on macOS to regenerate the lockfile —
;      it silently drops those nodes and re-breaks CI (this has happened twice).
;
;  If you must regenerate the lockfile, target linux/x64 so the @emnapi nodes
;  are retained (this still records every platform's bindings and produces a
;  lockfile byte-identical to the committed one):
;
;    rm -rf node_modules package-lock.json
;    npm install --package-lock-only --os=linux --cpu=x64
;    npm install                 # restore node_modules for local dev
;
;  Verify before committing:
;
;    npm ci && npm run typecheck && npm test
;    grep -c '"node_modules/@emnapi' package-lock.json    # must print 3
;
;  See README.md ("Lockfile note") for the full explanation.
; ============================================================================

; The lockfile is the source of truth for CI's `npm ci`; always keep it written.
package-lock=true
